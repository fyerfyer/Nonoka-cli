{
  "schema_version": "1.0",
  "name": "nonoka-cli-project",
  "description": "Example plugin manifest for a Python CLI project.",
  "skills": [
    {
      "name": "agent-cli-testing",
      "description": "pytest conventions for agent CLI projects"
    }
  ],
  "agents": [
    {
      "name": "planner",
      "description": "Breaks complex tasks into concrete steps.",
      "model": "gpt-4o-mini",
      "max_turns": 5,
      "allowed_tools": ["plan_task", "todowrite"]
    },
    {
      "name": "executor",
      "description": "Executes the planned steps using file and shell tools.",
      "model": "gpt-4o",
      "max_turns": 20,
      "allowed_tools": ["read_file", "write_file", "edit_file", "execute_command"]
    }
  ],
  "mcp_servers": {},
  "commands": [
    {
      "name": "test",
      "description": "Run the unit and integration test suite.",
      "command": "uv run pytest tests/unit tests/integration"
    }
  ],
  "hooks": [],
  "allowed_tools": []
}
