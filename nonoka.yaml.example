# nonoka-cli configuration example — Deepseek API
# Copy to ~/.config/nonoka/config.yaml to use

model: "deepseek-chat"

# API key / base URL are normally loaded from environment variables or a .env
# file. nonoka-cli automatically loads ~/.config/nonoka/.env and ./.env.
# You can also set them here (not recommended for api_key).
# api_key: "${DEEPSEEK_API_KEY}"
# base_url: "https://api.deepseek.com"

# Optional: override the default system prompt.
# If omitted, nonoka-cli uses a built-in coding-assistant prompt that
# explains the available tools and encourages autonomous tool use.
# system_prompt: |
#   You are nonoka, a helpful AI assistant running in a terminal.
#   Be concise but thorough in your responses.

# TODO: MCP server configuration 
# mcp_servers:
#   filesystem:
#     transport: stdio
#     command: npx
#     args:
#       - "-y"
#       - "@modelcontextprotocol/server-filesystem"
#       - "~"

# Local tool scan paths. In OpenCode mode these are exposed as
# custom__<tool-name>; standalone mode keeps the original tool name.
# tool_paths:
#   - ~/.config/nonoka/tools/

# Enabled skills discovered from .agents/skills/<name>/SKILL.md (project)
# or ~/.agents/skills/<name>/SKILL.md (user). Project definitions win.
# skills:
#   - code-review

cli:
  theme: dark
  auto_approve: false
  editor: "${EDITOR:-nano}"
  max_history: 1000

hitl:
  policy: interactive
  dangerous_tools:
    - write_file
    - edit_file
    - delete_file
    - execute_command

# Sandbox and filesystem policy. Docker is fail-closed: when unavailable,
# execute_command returns an error rather than running directly on the host.
safety:
  enabled: true
  sandbox: docker
  # Additional directories an agent may access. The working directory is
  # always allowed; .env, .ssh and .git remain denied.
  allowed_roots: []
